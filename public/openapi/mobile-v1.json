{
  "openapi": "3.1.0",
  "info": {
    "title": "Hanavi 공개 모바일 API",
    "version": "1.0.0",
    "description": "일반 사용자가 읽을 수 있는 시간표, 일정 검색, 멤버와 공식 링크입니다."
  },
  "servers": [
    {
      "url": "/api/mobile/v1"
    }
  ],
  "paths": {
    "/schedule": {
      "get": {
        "operationId": "getSchedule",
        "summary": "주차 시간표를 읽는다",
        "parameters": [
          {
            "name": "week",
            "in": "query",
            "description": "생략하면 최신 활성 주차",
            "schema": {
              "type": "string",
              "pattern": "^\\d{2}\\.\\d{2} - \\d{2}\\.\\d{2}$"
            },
            "example": "11.23 - 11.29"
          }
        ],
        "responses": {
          "200": {
            "description": "공개 데이터 조회",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "schemaVersion": {
                      "const": 1
                    },
                    "syncedAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "data": {
                      "$ref": "#/components/schemas/WeeklySchedule"
                    }
                  },
                  "required": [
                    "schemaVersion",
                    "syncedAt",
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "입력 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "properties": {
                        "error": {
                          "properties": {
                            "code": {
                              "const": "BAD_REQUEST"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "공개 결과 없음",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "properties": {
                        "error": {
                          "properties": {
                            "code": {
                              "const": "NOT_FOUND"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "503": {
            "description": "일시적으로 조회 불가",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "properties": {
                        "error": {
                          "properties": {
                            "code": {
                              "const": "UPSTREAM_UNAVAILABLE"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/schedule/image": {
      "get": {
        "summary": "Download a PNG rendered from public schedule data",
        "parameters": [
          {
            "in": "query",
            "name": "week",
            "required": true,
            "schema": {
              "type": "string",
              "example": "11.23 - 11.29"
            }
          },
          {
            "in": "query",
            "name": "view",
            "schema": {
              "type": "string",
              "enum": [
                "member",
                "weekly"
              ],
              "default": "member"
            }
          },
          {
            "in": "query",
            "name": "theme",
            "schema": {
              "type": "string",
              "enum": [
                "v2",
                "classic"
              ],
              "default": "v2"
            }
          },
          {
            "in": "query",
            "name": "member",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "maxItems": 24,
              "items": {
                "type": "string"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Schedule PNG",
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Invalid export options"
          },
          "404": {
            "description": "Schedule not found"
          },
          "503": {
            "description": "Schedule export unavailable"
          }
        }
      }
    },
    "/schedule/search": {
      "get": {
        "operationId": "searchSchedule",
        "summary": "지난 공개 일정 제목을 검색한다",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          }
        ],
        "responses": {
          "200": {
            "description": "공개 데이터 조회",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "schemaVersion": {
                      "const": 1
                    },
                    "syncedAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "data": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "results": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/SearchResult"
                          },
                          "maxItems": 40
                        },
                        "hasMore": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "results",
                        "hasMore"
                      ]
                    }
                  },
                  "required": [
                    "schemaVersion",
                    "syncedAt",
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "입력 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "properties": {
                        "error": {
                          "properties": {
                            "code": {
                              "const": "BAD_REQUEST"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "503": {
            "description": "일시적으로 조회 불가",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "properties": {
                        "error": {
                          "properties": {
                            "code": {
                              "const": "UPSTREAM_UNAVAILABLE"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/members": {
      "get": {
        "operationId": "getMembers",
        "summary": "현재 멤버 목록을 읽는다",
        "responses": {
          "200": {
            "description": "공개 데이터 조회",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "schemaVersion": {
                      "const": 1
                    },
                    "syncedAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Member"
                      }
                    }
                  },
                  "required": [
                    "schemaVersion",
                    "syncedAt",
                    "data"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "일시적으로 조회 불가",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "properties": {
                        "error": {
                          "properties": {
                            "code": {
                              "const": "UPSTREAM_UNAVAILABLE"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/members/{id}": {
      "get": {
        "operationId": "getMember",
        "summary": "현재 멤버를 ID로 읽는다",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,100}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "공개 데이터 조회",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "schemaVersion": {
                      "const": 1
                    },
                    "syncedAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Member"
                    }
                  },
                  "required": [
                    "schemaVersion",
                    "syncedAt",
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "입력 형식 오류",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "properties": {
                        "error": {
                          "properties": {
                            "code": {
                              "const": "BAD_REQUEST"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "공개 결과 없음",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "properties": {
                        "error": {
                          "properties": {
                            "code": {
                              "const": "NOT_FOUND"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "503": {
            "description": "일시적으로 조회 불가",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "properties": {
                        "error": {
                          "properties": {
                            "code": {
                              "const": "UPSTREAM_UNAVAILABLE"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/settings/links": {
      "get": {
        "operationId": "getGroupLinks",
        "summary": "공개 그룹 링크를 읽는다",
        "responses": {
          "200": {
            "description": "공개 데이터 조회",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "schemaVersion": {
                      "const": 1
                    },
                    "syncedAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/GroupLink"
                      }
                    }
                  },
                  "required": [
                    "schemaVersion",
                    "syncedAt",
