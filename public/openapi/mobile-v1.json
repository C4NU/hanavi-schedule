    },
    "/schedule/memos": {
      "post": {
        "operationId": "submitScheduleMemo",
        "summary": "공개 일정 제보 등록",
        "description": "같은 요청 ID와 대상·본문으로 재시도하면 저장된 메모를 돌려준다. 10분에 발신자 5건, 방송 20건으로 제한한다.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "week",
                  "requestId",
                  "target",
                  "content"
                ],
                "properties": {
                  "week": {
                    "type": "string",
                    "pattern": "^\\d{2}\\.\\d{2} - \\d{2}\\.\\d{2}$"
                  },
                  "requestId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "target": {
                    "type": "object",
                    "required": [
                      "kind",
                      "id"
                    ],
                    "properties": {
                      "kind": {
                        "enum": [
                          "event",
                          "legacy"
                        ]
                      },
                      "id": {
                        "type": "string",
                        "format": "uuid"
                      }
                    }
                  },
                  "content": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "기존 요청의 저장 결과",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "schemaVersion": {
                      "const": 1
                    },
                    "syncedAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Memo"
                    }
                  },
                  "required": [
                    "schemaVersion",
                    "syncedAt",
                    "data"
                  ]
                }
              }
            }
          },
          "201": {
            "description": "제보 등록 성공",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "schemaVersion": {
                      "const": 1
                    },
                    "syncedAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Memo"
                    }
                  },
                  "required": [
                    "schemaVersion",
                    "syncedAt",
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "잘못된 요청",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "properties": {
                        "error": {
                          "properties": {
                            "code": {
                              "const": "BAD_REQUEST"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "공개 방송을 찾을 수 없음",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "properties": {
                        "error": {
                          "properties": {
                            "code": {
                              "const": "BAD_REQUEST"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "409": {
            "description": "같은 요청 ID의 내용이 다름",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "properties": {
                        "error": {
                          "properties": {
                            "code": {
                              "const": "BAD_REQUEST"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "413": {
            "description": "요청 본문 크기 초과",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "properties": {
                        "error": {
                          "properties": {
                            "code": {
                              "const": "BAD_REQUEST"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "429": {
            "description": "등록 요청 제한",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "properties": {
                        "error": {
                          "properties": {
                            "code": {
                              "const": "BAD_REQUEST"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "다시 요청할 때까지 기다릴 초"
              }
            }
          },
          "503": {
            "description": "상위 서버 오류",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "properties": {
                        "error": {
                          "properties": {
                            "code": {
                              "const": "BAD_REQUEST"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/push/subscription": {
      "put": {
        "operationId": "upsertPushSubscription",
        "summary": "기기 알림 등록 또는 토큰 갱신",
        "description": "같은 설치 키로 60일 이내에 다시 요청하면 해당 기기의 FCM 토큰과 만료를 갱신한다. 앱 알림이 활성화된 환경에서만 사용할 수 있다.",
        "security": [
          {
            "MobileInstallation": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "token",
                  "platform"
                ],
                "properties": {
                  "token": {
                    "type": "string",
                    "minLength": 100,
                    "maxLength": 500,
                    "pattern": "^[a-zA-Z0-9_:%-]+$"
                  },
                  "platform": {
                    "enum": [
                      "ios",
                      "android"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "설치의 구독 상태가 갱신됨",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "schemaVersion",
                    "syncedAt",
                    "data"
                  ],
                  "properties": {
                    "schemaVersion": {
                      "const": 1
                    },
                    "syncedAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "subscribed"
                      ],
                      "properties": {
                        "subscribed": {
                          "const": true
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "설치 인증 키가 없음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "앱 알림 등록이 비활성화됨",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "등록 요청 한도를 초과함",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "등록 서비스를 사용할 수 없음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "400": {
            "description": "요청 또는 FCM 토큰이 유효하지 않음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "요청 본문이 1024바이트를 초과함",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "removePushSubscription",
        "summary": "현재 설치의 알림 구독 해제",
        "security": [
          {
            "MobileInstallation": []
          }
        ],
        "responses": {
          "200": {
            "description": "설치의 구독이 해제됨",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "schemaVersion",
                    "syncedAt",
                    "data"
                  ],
                  "properties": {
                    "schemaVersion": {
                      "const": 1
                    },
                    "syncedAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "subscribed"
                      ],
                      "properties": {
                        "subscribed": {
                          "const": false
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "설치 인증 키가 없음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "앱 알림 등록이 비활성화됨",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "등록 요청 한도를 초과함",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "등록 서비스를 사용할 수 없음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
